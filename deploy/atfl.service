# Above the Fog Line game server — runs on free-micro-1 (Oracle Always Free)
[Unit]
Description=Above the Fog Line game server (email turn poll loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=atfl
Group=atfl
WorkingDirectory=/srv/atfl/atfl
EnvironmentFile=/etc/atfl/atfl.env
ExecStart=/srv/atfl/venv/bin/python -m server.poll
Restart=always
RestartSec=30
# A loud startup refusal (exit 2: config error, e.g. ATFL_MURPH_NODE
# blank or ATFL_A8S_NODE_ROOT unset) never heals on retry, so don't
# flap it every 30s; the unit lands in "failed" with the refusal in the
# journal until the config is fixed. Real crashes (OOM, host reboot, VM
# replacement) still auto-restart.
RestartPreventExitStatus=2
# Per-cycle crashes are already swallowed by the poll loop (it logs and
# continues); Restart=always covers the process itself dying (OOM, host
# reboot, VM replacement). The games dir holds everything durable —
# game SQLite files and mailer.db travel with the checkout, nothing
# lives in /tmp.

# Hardening: read-only system, with write access only where the relay
# needs it: the games dir (game SQLite files + mailer.db) and the engine
# A8S node root (server/murph_relay.send_outbound stages `a8s tell`
# outbox files under <ATFL_A8S_NODE_ROOT>/.outbox; the node daemon, when
# it runs, also writes its inbox under the same root). Everything else —
# including the checkout at /srv/atfl/atfl — stays read-only.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/atfl /srv/atfl/a8s /srv/atfl/.config/a8s
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
